# Joi/Aurion Companion Configuration — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# --- LLM provider keys (set only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# --- Application settings ---
DEBUG=false
LOG_LEVEL=INFO

# --- LLM provider selection ---
# Priority order (auto): ollama -> sillytavern -> oobabooga -> openrouter -> cohere -> openai -> anthropic
AURION_LLM_PROVIDER=auto
AURION_LLM_MODEL=

# --- Optional local provider URLs ---
AURION_OLLAMA_URL=
AURION_SILLYTAVERN_URL=
AURION_OOBABOOGA_URL=

# --- Chain-of-thought reasoning ---
AURION_COT_ENABLED=true
AURION_COT_MODEL=

# --- Content settings ---
AURION_ADULT_CONTENT=false
AURION_INTIMACY_MODE=
AURION_ADULT_CONTENT_STYLE=
AURION_PROFANITY_MODE=
AURION_ADULT_TOPIC_MODE=
